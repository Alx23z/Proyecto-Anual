{
  // Ajustes del editor y formato
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": null,
  "editor.minimap.enabled": false,
  // Configuración de PHP (si usas la extensión oficial o de compilación)
  "php.suggest.basic": true,
  "php.validate.executablePath": "",
  // Ocultar archivos innecesarios en el explorador de VS Code
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  }
}